[Unit]
Description=PinoyProto Bambu Studio control API
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=bambu-control
Group=bambu-control
WorkingDirectory=/opt/pinoyproto-bambu-control
EnvironmentFile=/etc/pinoyproto-bambu-control.env
ExecStart=/opt/pinoyproto-bambu-control/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8788
Restart=on-failure
RestartSec=3
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
