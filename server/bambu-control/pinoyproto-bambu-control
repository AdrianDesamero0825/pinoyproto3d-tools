#!/bin/sh
set -eu

case "${1-}" in
  status)
    /usr/bin/docker inspect --format '{{.State.Running}}' bambu-studio
    ;;
  start)
    running=$(/usr/bin/docker inspect --format '{{.State.Running}}' bambu-studio)
    if [ "$running" = "false" ]; then
      /usr/bin/docker start bambu-studio
    else
      echo "already running"
    fi
    ;;
  stop)
    running=$(/usr/bin/docker inspect --format '{{.State.Running}}' bambu-studio)
    if [ "$running" = "true" ]; then
      /usr/bin/docker stop --time 10 bambu-studio
    else
      echo "already stopped"
    fi
    ;;
  *)
    echo "Allowed actions: status, start, stop" >&2
    exit 2
    ;;
esac
